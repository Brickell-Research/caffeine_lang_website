Blueprints for "SLO"
  * "Simple_SLO":
    Requires { service_name: String, excluded_service_name: String }
    Provides {
      vendor: "datadog",
      queries: {
        numerator: "sum:successes{$$service->service_name$$, $$service_name->excluded_service_name:not$$}",
        denominator: "sum:total{$$service->service_name$$}"
      },
      value: "numerator / denominator"
    }
