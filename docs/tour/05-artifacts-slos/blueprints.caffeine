Blueprints for "SLO"
  * "Simple_SLO":
    Requires { service_name: String }
    Provides {
      vendor: "datadog",
      indicators: {
        numerator: "sum:successes{$$service->service_name$$}",
        denominator: "sum:total{$$service->service_name$$}"
      },
      evaluation: "numerator / denominator"
    }
