Expectations measured by "api_availability"
  * "checkout_availability":
    Provides {
      env: "production",
      status: true,
      threshold: 99.95%,
      window_in_days: 30
    }

  * "payment_availability":
    Provides {
      env: "production",
      status: true,
      threshold: 99.0%,
      window_in_days: 30
    }
