_env (Requires): { env: String }

"api_availability" extends [_env]:
  Requires {
    status: Boolean,
  }
  Provides {
    evaluation: "numerator / denominator",
    indicators: {
      numerator: "sum:http.requests{$$env->env$$, $$status->status:not$$}",
      denominator: "sum:http.requests{$$env->env$$}"
    }
  }
