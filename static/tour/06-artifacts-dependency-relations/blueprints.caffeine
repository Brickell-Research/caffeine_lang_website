Blueprints for "SLO"
  * "Availability_SLO":
    Requires { service_name: String }
    Provides {
      vendor: "datadog",
      queries: {
        numerator: "sum:requests.success{service:example}.as_count()",
        denominator: "sum:requests.total{service:example}.as_count()"
      },
      value: "numerator / denominator"
    }

Blueprints for "DependencyRelation"
  * "hard_dependency":
    Requires { from: String, to: String }
    Provides { type: "hard" }

  * "soft_dependency":
    Requires { from: String, to: String }
    Provides { type: "soft" }
